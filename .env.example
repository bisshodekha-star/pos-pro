# ============================================================
#  POS Pro — Environment Variables
#  Copy this file to:
#    .dev.vars   (for local dev with `npx wrangler pages dev`)
#
#  For PRODUCTION on Cloudflare Pages, set these in:
#    Cloudflare Dashboard → Pages → pos-pro → Settings → Environment variables
# ============================================================

# Neon database connection string (from Neon dashboard)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# JWT secret — any long random string (32+ chars recommended)
# Generate one: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret-string

# JWT issuer (any identifier)
JWT_ISSUER=pos-pro
